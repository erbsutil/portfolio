---
/**
 * ProjectCard — case list row.
 *
 * Scan path: optional badge → title → outcome → tech line → View case.
 * Year lives on the section heading, not on each card.
 * Photo top = first content row (badge if present, otherwise title).
 */

import BaseCard from "./BaseCard.astro";
import ForwardLink from "./ForwardLink.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { defaultLocale, withLocale, type AppLocale } from "../i18n/config";

interface Props {
  title: string;
  slug: string;
  outcomeSummary: string;
  year: number;
  techStack?: string[];
  featured?: boolean;
  status?: "completed" | "ongoing" | "archived";
  isMeta?: boolean;
  id?: string;
  locale?: AppLocale;
  viewLabel?: string;
  featuredLabel?: string;
  moreTechLabel?: string;
  statusLabels?: Record<"completed" | "ongoing" | "archived", string>;
  cover?: ImageMetadata;
}

const {
  title,
  slug,
  outcomeSummary,
  techStack = [],
  status = "completed",
  isMeta = false,
  id,
  locale = defaultLocale,
  viewLabel = "View case",
  featuredLabel = "Featured",
  moreTechLabel = "{n} more technologies",
  statusLabels = {
    completed: "Completed",
    ongoing: "Ongoing",
    archived: "Archived",
  },
  cover,
} = Astro.props;

const showBadge = isMeta || status !== "completed";

const href = withLocale(locale, `/projects/${slug}`);

/** Short label for list; full string kept in title for hover. */
const shortTech = (label: string) => {
  const primary = label.split(/[+(,/]/)[0]?.trim() ?? label;
  return primary.length > 18 ? `${primary.slice(0, 16).trimEnd()}…` : primary;
};

const techChips = techStack.map((tech) => ({
  full: tech,
  short: shortTech(tech),
}));

const previewCount = 4;
const previewTech = techChips.slice(0, previewCount);
const extraCount = Math.max(0, techChips.length - previewCount);

const statusConfig = {
  completed: { label: statusLabels.completed, class: "status--completed" },
  ongoing: { label: statusLabels.ongoing, class: "status--ongoing" },
  archived: { label: statusLabels.archived, class: "status--archived" },
};
const statusInfo = statusConfig[status];
---

<BaseCard
  href={href}
  class:list={[
    "project-card",
    { "project-card--meta": isMeta, "project-card--thumb": !!cover },
  ]}
  id={id}
>
  {
    cover && (
      <div slot="image" class="project-thumb">
        <span class="project-thumb__link">
          <Image
            src={cover}
            alt=""
            widths={[160, 240, 320]}
            sizes="(min-width: 720px) 9.5rem, 0"
            loading="lazy"
            decoding="async"
            class="project-thumb__img"
          />
        </span>
      </div>
    )
  }

  {
    showBadge && (
      <div slot="badge" class="card-badges">
        {isMeta && <span class="badge badge--featured">{featuredLabel}</span>}
        {status !== "completed" && (
          <span class:list={["badge", `badge--${status}`]}>
            {statusInfo.label}
          </span>
        )}
      </div>
    )
  }

  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{outcomeSummary}</Fragment>

  <div slot="tags" class="case-rail">
    {/* Always reserve meta band so missing tech does not lift the CTA */}
    <p class="meta-line">
      {
        previewTech.length > 0 && (
          <>
            {previewTech.map((tech, i) => (
              <>
                {i > 0 && <span class="meta-line__sep" aria-hidden="true"> · </span>}
                <span title={tech.full}>{tech.short}</span>
              </>
            ))}
            {extraCount > 0 && (
              <span
                class="meta-line__extra"
                aria-label={moreTechLabel.replace("{n}", String(extraCount))}
              >
                {" "}
                · +{extraCount}
              </span>
            )}
          </>
        )
      }
    </p>
    <ForwardLink text={viewLabel} class="case-cta" />
  </div>
</BaseCard>

<style>
  .card-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    margin-bottom: 0;
  }

  /* Photo top = title when no badge; only pad kicker when a badge exists */
  :global(.project-card .card-header:has(.badge)) {
    min-height: var(--teaser-kicker-min-h);
    margin-bottom: var(--teaser-kicker-gap);
  }

  :global(.project-card.base-card--link:hover .card-title),
  :global(.project-card.base-card--link:focus-visible .card-title) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--border-radius-sm);
    border: 1px solid transparent;
  }

  .badge--featured {
    background: var(--color-accent-muted);
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
  }

  .badge--ongoing {
    background: var(--color-accent-muted);
    color: var(--color-status-ongoing);
    border-color: color-mix(
      in srgb,
      var(--color-status-ongoing) 35%,
      var(--color-border)
    );
  }

  .badge--archived {
    background: var(--color-bg-secondary);
    color: var(--color-status-archived);
    border-color: var(--color-border);
  }

  :global(.project-card .card-title) {
    font-size: 1.1875rem;
    line-height: 1.3;
    margin-bottom: var(--teaser-title-gap);
    max-width: none;
    text-wrap: unset;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.project-card .card-description) {
    max-width: none;
    margin-bottom: 0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Reserve title/dek bands only in the 2-col folio so mobile stays tight */
  @media (min-width: 900px) {
    :global(.project-card .card-title) {
      min-height: calc(1.3em * 2);
    }

    :global(.project-card .card-description) {
      min-height: calc(1.55em * 3);
    }
  }

  .case-rail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    max-width: 38rem;
    width: 100%;
  }

  .case-rail .meta-line {
    width: 100%;
    max-width: 100%;
    min-height: 1.45em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .case-cta {
    margin: 0;
  }

  /* Fill row height so tech line + Ver case share one baseline */
  :global(.project-card .card-content) {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  :global(.project-card .case-rail) {
    margin-top: auto;
    padding-top: var(--teaser-cta-pad);
  }

  .project-thumb {
    display: none;
  }

  @media (min-width: 720px) {
    :global(.base-card.project-card--thumb) {
      display: grid;
      grid-template-columns: 9.5rem minmax(0, 1fr);
      column-gap: var(--teaser-media-gap);
      align-items: stretch;
    }

    .project-thumb {
      display: block;
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      width: 9.5rem;
      border: 1px solid var(--color-border);
      background: var(--color-bg-secondary);
      overflow: hidden;
      line-height: 0;
    }

    .project-thumb__link {
      display: block;
    }

    .project-thumb__img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      object-position: top center;
      display: block;
    }

    :global(.project-card--thumb .card-content) {
      grid-column: 2;
      min-width: 0;
      height: 100%;
    }
  }
</style>
