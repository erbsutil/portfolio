---
/**
 * BaseCard Component
 *
 * Hairline row surface (not a floating white card). Hover darkens via --color-bg-hover.
 *
 * @component
 */

interface Props {
  href?: string;
  class?: string;
  id?: string;
}

const { href, class: className, id } = Astro.props;
const Tag = href ? "a" : "div";
const showHeader = Astro.slots.has("meta") || Astro.slots.has("badge");
---

<Tag
  href={href}
  id={id}
  class:list={["base-card", { "base-card--link": href }, className]}
>
  <slot name="image" />
  <div class="card-content">
    {
      showHeader && (
        <div
          class:list={[
            "card-header",
            {
              "card-header--split":
                Astro.slots.has("meta") && Astro.slots.has("badge"),
            },
          ]}
        >
          {
            Astro.slots.has("meta") && (
              <span class="card-meta">
                <slot name="meta" />
              </span>
            )
          }
          <slot name="badge" />
        </div>
      )
    }
    <span class="card-title"><slot name="title" /></span>
    <div class="card-description"><slot name="description" /></div>
    <slot name="tags" />
    <slot />
  </div>
  <slot name="footer" />
</Tag>

<style>
  .base-card {
    position: relative;
    background: transparent;
    border: none;
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    transition: none;
    overflow: hidden;
    scroll-margin-top: 5rem;
  }

  .base-card--link {
    display: block;
    cursor: pointer;
  }

  .base-card--link:hover,
  .base-card--link:focus-visible {
    border-color: transparent;
    background: transparent;
    color: inherit;
  }

  .base-card--link:hover .card-title,
  .base-card--link:focus-visible .card-title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  .base-card--link:hover :global(.arrow-link--accent.arrow-link--nested),
  .base-card--link:focus-visible :global(.arrow-link--accent.arrow-link--nested) {
    color: var(--color-accent-hover);
  }

  .base-card--link:hover :global(.arrow-link--muted.arrow-link--nested),
  .base-card--link:focus-visible :global(.arrow-link--muted.arrow-link--nested) {
    color: var(--color-text);
  }

  .base-card--link:hover :global(.arrow-icon),
  .base-card--link:focus-visible :global(.arrow-icon) {
    transform: translateX(3px);
  }

  .base-card--link:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
    border-radius: 2px;
  }

  .card-content {
    padding: 0;
  }

  .card-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--teaser-kicker-gap, 0.45rem);
    gap: 0.5rem 0.75rem;
  }

  .card-header--split {
    justify-content: space-between;
    align-items: flex-start;
  }

  .card-header:empty {
    display: none;
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .card-meta:empty {
    display: none;
  }

  .card-title {
    display: block;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    line-height: 1.4;
    max-width: 42rem;
    text-wrap: balance;
  }

  .card-description {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin-bottom: 0.85rem;
    max-width: 42rem;
  }

  @media (max-width: 640px) {
    .card-title {
      font-size: 1rem;
    }

    .card-description {
      font-size: 0.875rem;
    }
  }

  .base-card :global(.card-image) {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .base-card :global(.card-image img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
