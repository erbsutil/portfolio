---
/**
 * TalkLead — front-of-year editorial story for Community.
 * Large photo + display title; one primary link (no nested duplicate CTAs).
 * Rhythm: badge → date · place → title → event → dek → CTA. Photo top = content top.
 */
import { Image } from "astro:assets";
import ForwardLink from "./ForwardLink.astro";
import { htmlLang, type AppLocale } from "../i18n/config";

interface Props {
  title: string;
  description: string;
  event: string;
  date: Date;
  location: string;
  type: string;
  image?: any;
  href: string;
  locale: AppLocale;
  readMoreLabel: string;
  typeLabel: string;
}

const {
  title,
  description,
  event,
  date,
  location,
  type,
  image,
  href,
  locale,
  readMoreLabel,
  typeLabel,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat(htmlLang[locale], {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
---

<article class:list={["talk-lead", { "talk-lead--photo": !!image }]}>
  {
    image && (
      <div class="talk-lead__media" aria-hidden="true">
        <Image
          src={image}
          alt=""
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 899px) 92vw, min(28rem, 42vw)"
          loading="eager"
          decoding="async"
          class="talk-lead__img"
        />
      </div>
    )
  }

  <div class="talk-lead__body">
    <div class="talk-lead__kicker">
      <span class="talk-lead__badge" data-type={type}>{typeLabel}</span>
      <p class="talk-lead__meta">
        <span class="talk-lead__date">{formattedDate}</span>
        <span class="talk-lead__sep" aria-hidden="true">·</span>
        <span class="talk-lead__place">{location}</span>
      </p>
    </div>
    <h3 class="talk-lead__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="talk-lead__event">{event}</p>
    <p class="talk-lead__dek">{description}</p>
    <ForwardLink text={readMoreLabel} href={href} class="talk-lead__cta" />
  </div>
</article>

<style>
  .talk-lead {
    display: grid;
    gap: 1.25rem 2rem;
    align-items: start;
    padding-bottom: 1.75rem;
    margin-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }

  .talk-lead__media {
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    overflow: hidden;
    line-height: 0;
  }

  .talk-lead__img {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center;
  }

  .talk-lead__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Always: badge row → date · place (never side-by-side wrap) */
  .talk-lead__kicker {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0 0 var(--teaser-kicker-gap);
  }

  .talk-lead__badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    color: var(--color-accent);
    background: var(--color-accent-muted);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-border));
  }

  .talk-lead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .talk-lead__sep {
    opacity: 0.55;
  }

  .talk-lead__title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.8vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0 0 var(--teaser-title-gap);
    max-width: 28rem;
    text-wrap: balance;
  }

  .talk-lead__title a {
    color: inherit;
    text-decoration: none;
  }

  .talk-lead__title a:hover,
  .talk-lead__title a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  .talk-lead__title a:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .talk-lead__event {
    margin: 0 0 var(--teaser-event-gap);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .talk-lead__dek {
    margin: 0 0 var(--teaser-dek-gap);
    font-size: 1.025rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 36rem;
  }

  .talk-lead__cta {
    margin: 0;
  }

  /* Same 2-col folio as talks-secondary so lead photo lines up with cards below */
  @media (min-width: 900px) {
    .talk-lead--photo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.25rem;
      padding-bottom: 2.15rem;
      align-items: start;
    }

    .talk-lead--photo .talk-lead__img {
      aspect-ratio: 16 / 10;
      max-height: none;
    }
  }

  @media (max-width: 899px) {
    .talk-lead__dek {
      font-size: 0.975rem;
      -webkit-line-clamp: 5;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
