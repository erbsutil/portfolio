---
/**
 * ScrollToTop — fixed control that clears the footer when it enters view.
 */

interface Props {
  label?: string;
}

const { label = "Scroll to top" } = Astro.props;
---

<button
  class="scroll-to-top"
  type="button"
  aria-label={label}
  title={label}
  aria-hidden="true"
  tabindex="-1"
  data-scroll-top
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
</button>

<style>
  .scroll-to-top {
    --scroll-top-inset: 1.5rem;
    --scroll-top-gap: 0.75rem;
    position: fixed;
    bottom: max(var(--scroll-top-inset), env(safe-area-inset-bottom, 0px));
    right: max(var(--scroll-top-inset), env(safe-area-inset-right, 0px));
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      transform 0.2s ease,
      bottom 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
    z-index: 50;
  }

  .scroll-to-top:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .scroll-to-top:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  .scroll-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .scroll-to-top {
      --scroll-top-inset: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-to-top {
      transition: none;
    }
  }
</style>

<script>
  function initScrollToTop() {
    const node = document.querySelector("[data-scroll-top]");
    if (!(node instanceof HTMLElement)) return;
    const button = node;

    const SCROLL_THRESHOLD = 300;
    const footerNode = document.querySelector(".site-footer");
    const footer = footerNode instanceof HTMLElement ? footerNode : null;
    let footerVisible = false;

    function baseInset() {
      const styles = getComputedStyle(button);
      return parseFloat(styles.getPropertyValue("--scroll-top-inset")) || 24;
    }

    function gap() {
      const styles = getComputedStyle(button);
      return parseFloat(styles.getPropertyValue("--scroll-top-gap")) || 12;
    }

    function syncFooterClearance() {
      if (!footer || !footerVisible) {
        button.style.removeProperty("bottom");
        return;
      }

      const footerTop = footer.getBoundingClientRect().top;
      const overlap = window.innerHeight - footerTop;
      if (overlap <= 0) {
        button.style.removeProperty("bottom");
        return;
      }

      const nextBottom = Math.max(baseInset(), overlap + gap());
      button.style.bottom = `${nextBottom}px`;
    }

    function setVisible(visible: boolean) {
      button.classList.toggle("is-visible", visible);
      if (visible) {
        button.removeAttribute("aria-hidden");
        button.removeAttribute("tabindex");
      } else {
        button.setAttribute("aria-hidden", "true");
        button.setAttribute("tabindex", "-1");
      }
      syncFooterClearance();
    }

    function toggleVisibility() {
      setVisible(window.scrollY > SCROLL_THRESHOLD);
    }

    function scrollToTop() {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
        .matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    }

    window.addEventListener("scroll", toggleVisibility, { passive: true });
    window.addEventListener("resize", syncFooterClearance, { passive: true });
    button.addEventListener("click", scrollToTop);

    if (footer && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          footerVisible = entry.isIntersecting;
          syncFooterClearance();
        },
        { threshold: 0 },
      );
      observer.observe(footer);
    }

    toggleVisibility();
  }

  initScrollToTop();
  document.addEventListener("astro:after-swap", initScrollToTop);
</script>
