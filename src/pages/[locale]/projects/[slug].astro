  <script is:inline>
    (function () {
      function initCaseJump() {
        var nav = document.querySelector(".case-jump");
        if (!nav) return;

        var sections = [];
        var anchors = nav.querySelectorAll("a[href^='#']");
        for (var i = 0; i < anchors.length; i++) {
          var link = anchors[i];
          var href = link.getAttribute("href") || "";
          var id = href.slice(1);
          var el = id ? document.getElementById(id) : null;
          if (el) sections.push({ link: link, el: el });
        }
        if (!sections.length) return;

        function setCurrent(active) {
          for (var j = 0; j < sections.length; j++) {
            var item = sections[j];
            if (active && item.link === active) {
              item.link.setAttribute("aria-current", "true");
            } else {
              item.link.removeAttribute("aria-current");
            }
          }
        }

        var observer = new IntersectionObserver(
          function (entries) {
            var visible = entries
              .filter(function (e) {
                return e.isIntersecting;
              })
              .sort(function (a, b) {
                return a.target.offsetTop - b.target.offsetTop;
              });
            if (visible[0]) {
              for (var k = 0; k < sections.length; k++) {
                if (sections[k].el === visible[0].target) {
                  setCurrent(sections[k].link);
                  break;
                }
              }
            }
          },
          {
            rootMargin: "-20% 0px -55% 0px",
            threshold: [0, 0.25, 0.5],
          },
        );

        for (var n = 0; n < sections.length; n++) {
          observer.observe(sections[n].el);
        }
      }

      initCaseJump();
      document.addEventListener("astro:after-swap", initCaseJump);
    })();
  </script>
